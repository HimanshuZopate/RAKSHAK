PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb://localhost:27017/mern_security?authMechanism=DEFAULT

# JWT Secrets (Minimum 256-bit secure keys in production)
ACCESS_TOKEN_SECRET=dev_super_secret_access_jwt_key_987453216854123897!@#
REFRESH_TOKEN_SECRET=dev_super_secret_refresh_jwt_key_1238974561234987!@#
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Nodemailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Security Dashboard <noreply@securitydashboard.local>"

# AI Assistant Configuration (AI RAKSHAK)
# Supports: groq, gemini, openai, or built-in intelligent cyber engine (offline zero-config)
AI_ENABLED=true
# auto = Gemini key pool -> Groq -> OpenAI -> offline engine. Or: gemini | groq | openai | offline
AI_PROVIDER=auto

# Gemini key pool (random rotation + automatic quota failover). Empty values are ignored.
# NOTE: Gemini rate limits apply per Google Cloud project. Keys from the SAME project share
# one quota; use keys from different projects if you need more capacity.
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Legacy single-key variable (still supported; merged into the pool, duplicates ignored)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3.x thinking: minimal | low | medium | high | default (model default). Lower = faster replies.
GEMINI_THINKING_LEVEL=minimal

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Per-attempt timeout and overall budget for one chat request across all keys/providers
AI_REQUEST_TIMEOUT_MS=15000
AI_TOTAL_TIMEOUT_MS=30000
# Verify keys/models at startup with a metadata request (no generation quota used)
AI_STARTUP_VALIDATION=true
